{
  "name": "excuse",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "让想象力拥有生产力。",
  "author": "18267094443@163.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/puzzle-fuzzy/excuse.git"
  },
  "module": "index.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@elysia/bearer": "1.4.4",
    "@elysia/cors": "1.4.2",
    "@elysia/eden": "1.4.10",
    "@elysia/jwt": "1.4.2",
    "@elysia/static": "1.4.11",
    "@elysiajs/cookie": "0.8.0",
    "@elysiajs/openapi": "1.4.15",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/inter": "5.2.8",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "currency.js": "2.0.4",
    "elysia": "1.4.28",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.17.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:boundaries": "bun scripts/check-package-boundaries.ts",
    "check:assets": "bun --env-file .env scripts/check-assets-consistency.ts",
    "kill-ports": "bun --env-file .env scripts/kill-ports.ts",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "dev:site": "bun run --cwd apps/site dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev": "bun run kill-ports && concurrently \"bun run dev:server\" \"bun run dev:client\" \"bun run dev:worker\" \"bun run dev:site\" \"bun run dev:admin\" --names \"SERVER,CLIENT,WORKER,SITE,ADMIN\" --prefix-colors \"bgBlue.bold,bgGreen.bold,bgYellow.bold,bgMagenta.bold,bgCyan.bold\" --kill-others-on-fail",
    "build:server": "bun run --cwd apps/server build",
    "build:worker": "bun run --cwd apps/worker build",
    "build:client": "bun run --cwd apps/client build",
    "build:site": "bun run --cwd apps/site build",
    "build:admin": "bun run --cwd apps/admin build",
    "build": "bun run build:server && bun run build:worker && bun run build:client && bun run build:site && bun run build:admin",
    "typecheck": "concurrently \"bun run --cwd apps/server typecheck\" \"bun run --cwd apps/client typecheck\" \"bun run --cwd apps/worker typecheck\" \"bun run --cwd apps/site typecheck\" \"bun run --cwd apps/admin typecheck\" \"bun run typecheck:e2e\"",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test:packages": "bun scripts/run-package-tests.ts",
    "test": "concurrently \"bun run --cwd apps/server test\" \"bun run --cwd apps/worker test\" \"bun run test:packages\" --names \"SERVER,WORKER,PACKAGES\" --prefix-colors \"bgBlue.bold,bgYellow.bold,bgGreen.bold\"",
    "test:isolate": "bun test --isolate",
    "test:client": "bun run --cwd apps/client test",
    "test:e2e": "bun test e2e",
    "test:all": "bun run test && bun run test:client",
    "test:db": "bun run --cwd packages/db test:db",
    "test:coverage": "bun run test --coverage && bun run test:client -- --coverage"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "currency.js": "catalog:",
    "nodemailer": "^9.0.0",
    "p-limit": "^7.3.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.17",
    "@types/ali-oss": "^6.23.3",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-plugin-react-refresh": "^0.5.2"
  }
}
