---
// 统一图标组件：底层用 @lucide/astro。consts.ts 里的 icon 字段填 registry 的 key。
// name 接受 string（数据源是 string），运行时查表，未命中回落到 Sparkles。
import { Boxes, Captions, Clapperboard, Code, Coins, Film, Image, LayoutGrid, Megaphone, Palette, RefreshCw, Sparkles, Video, Workflow } from '@lucide/astro'

const registry = {
  megaphone: Megaphone,
  clapperboard: Clapperboard,
  captions: Captions,
  film: Film,
  workflow: Workflow,
  'layout-grid': LayoutGrid,
  coins: Coins,
  'refresh-cw': RefreshCw,
  code: Code,
  boxes: Boxes,
  image: Image,
  video: Video,
  palette: Palette,
} as const

interface Props {
  name: string
  size?: number | string
  class?: string
  strokeWidth?: number
}

const { name, size = 24, class: className, strokeWidth = 1.75 } = Astro.props
const Cmp = (registry as Record<string, typeof Sparkles>)[name] ?? Sparkles
---

<Cmp size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" />
