---
import { Moon, Sun } from '@lucide/astro'
---

<button
  type="button"
  data-theme-toggle
  class="flex size-9 items-center justify-center rounded-lg text-ink-soft transition-colors hover:bg-brand-50 hover:text-ink"
  aria-label="切换深色 / 浅色主题"
  title="切换深色 / 浅色主题"
>
  {/* 亮色下显示月亮（点击切到暗色），暗色下显示太阳 */}
  <Moon class="size-5 dark:hidden" />
  <Sun class="hidden size-5 dark:block" />
</button>

<script is:inline>
  // 页面里 ThemeToggle 会渲染多次（桌面 + 移动端），每个实例各带一份本脚本。
  // 用 querySelectorAll + data-theme-bound 幂等守卫，确保每个按钮只绑一次监听，
  // 否则点一次会触发多次 toggle（暗→亮→暗），表现为"按钮没效果"。
  (function () {
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      if (btn.dataset.themeBound) return;
      btn.dataset.themeBound = '1';
      btn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    });
  })();
</script>
