---
import { Moon, Sun } from '@lucide/astro'
---

<button
  id="theme-toggle"
  type="button"
  class="flex size-9 items-center justify-center rounded-lg text-ink-soft transition-colors hover:bg-brand-50 hover:text-ink"
  aria-label="切换深色 / 浅色主题"
  title="切换深色 / 浅色主题"
>
  {/* 亮色下显示月亮（点击切到暗色），暗色下显示太阳 */}
  <Moon class="size-5 dark:hidden" />
  <Sun class="hidden size-5 dark:block" />
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  })();
</script>
