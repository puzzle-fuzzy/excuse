---
import { Menu, Sparkles, X } from '@lucide/astro'
import { APP_URL, NAV_LINKS, SITE } from '../consts'
import HeaderLink from './HeaderLink.astro'
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/')
// 在非首页给 header 一点底色分隔
const isHome = pathname === '/'
---

<header
  class:list={[
    'sticky top-0 z-40 border-b backdrop-blur-md',
    isHome ? 'border-transparent bg-surface/70' : 'border-line bg-surface/80',
  ]}
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <!-- 品牌 -->
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <span class="flex size-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-sm">
        <Sparkles size={18} stroke-width={2} />
      </span>
      <span class="text-lg font-bold tracking-tight text-ink">{SITE.name}</span>
    </a>

    <!-- 桌面导航 -->
    <nav class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map(link => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
    </nav>

    <!-- 桌面：主题切换 + CTA -->
    <div class="hidden items-center gap-1 md:flex">
      <ThemeToggle />
      <a href={APP_URL} class="btn-ghost">登录</a>
      <a href={APP_URL} class="btn-primary">免费开始</a>
    </div>

    <!-- 移动端：主题切换 + 菜单（纯 CSS disclosure） -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <details class="group relative">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg text-ink hover:bg-brand-50 [&::-webkit-details-marker]:hidden"
          aria-label="打开菜单"
        >
          <Menu class="size-6 group-open:hidden" />
          <X class="hidden size-6 group-open:block" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-line bg-surface p-2 shadow-lg">
          {NAV_LINKS.map(link => (
            <a href={link.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-brand-50 hover:text-ink">
              {link.label}
            </a>
          ))}
          <hr class="my-2 border-line" />
          <a href={APP_URL} class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">登录 / 免费开始</a>
        </div>
      </details>
    </div>
  </div>
</header>
