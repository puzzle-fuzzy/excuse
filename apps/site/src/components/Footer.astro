---
import { APP_URL, FOOTER_NAV, SITE, SOCIAL_LINKS } from '../consts'

const year = new Date().getFullYear()
---

<footer class="border-t border-black/5 bg-brand-50/40">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(4,1fr)]">
      <!-- 品牌简介 -->
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
          <span class="flex size-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.2 5.8L20 10l-5.8 2.2L12 18l-2.2-5.8L4 10l5.8-2.2L12 2z" />
            </svg>
          </span>
          <span class="text-lg font-bold tracking-tight text-ink">{SITE.name}</span>
        </a>
        <p class="mt-4 text-sm leading-6 text-ink-soft">{SITE.description}</p>
        <div class="mt-5 flex items-center gap-3">
          {SOCIAL_LINKS.map(s => (
            <a
              href={s.href}
              class="flex size-9 items-center justify-center rounded-lg border border-black/5 bg-white text-ink-soft transition-colors hover:border-brand-200 hover:text-brand-700"
              aria-label={s.label}
              rel={s.href !== '#' ? 'noopener noreferrer' : undefined}
              target={s.href !== '#' ? '_blank' : undefined}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- 导航分组 -->
      {FOOTER_NAV.map(col => (
        <div>
          <h3 class="text-sm font-semibold text-ink">{col.title}</h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map(link => (
              <li>
                <a href={link.href} class="text-sm text-ink-soft transition-colors hover:text-brand-700">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <hr class="my-8 border-black/5" />

    <div class="flex flex-col items-center justify-between gap-3 text-sm text-ink-soft sm:flex-row">
      <p>&copy; {year} {SITE.legalName}. 保留所有权利。</p>
      <div class="flex items-center gap-4">
        {SITE.icp && <span>{SITE.icp}</span>}
        <a href="/legal/terms" class="hover:text-brand-700">服务条款</a>
        <a href="/legal/privacy" class="hover:text-brand-700">隐私政策</a>
        <a href={APP_URL} class="font-medium text-brand-700 hover:text-brand-800">进入工作台 →</a>
      </div>
    </div>
  </div>
</footer>
