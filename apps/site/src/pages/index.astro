---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { APP_URL, CAPABILITIES, FAQ_ITEMS, PRICING_PLANS, PROCESS_STEPS, SITE, TRUST_ITEMS, USE_CASES } from '../consts'

const previewPlans = PRICING_PLANS.slice(0, 4)
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Hero -->
  <section class="bg-aurora">
    <div class="container-page py-20 text-center sm:py-28">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/70 px-4 py-1.5 text-sm font-medium text-brand-700">
        <span class="size-1.5 rounded-full bg-brand-500" /> AI 内容生产平台 · Canvas 流水线已上线
      </span>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-bold tracking-tight text-ink sm:text-6xl">
        让想象力<br class="hidden sm:block" />拥有<span class="text-brand-600">生产力</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-ink-soft sm:text-xl">
        从故事文本、提示词到图片、视频、字幕与成片。成本可见、任务可恢复、资产可复用，并提供开发者 API。
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={APP_URL} class="btn-primary text-base">免费开始 →</a>
        <a href="/product" class="btn-secondary text-base">了解产品</a>
      </div>
      <p class="mt-4 text-sm text-ink-soft">注册即享免费额度，无需信用卡</p>
    </div>
  </section>

  <!-- 场景入口 -->
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">应用场景</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">一个平台，覆盖你的创意生产</h2>
      <p class="mt-4 text-lg text-ink-soft">无论做广告图、短视频、字幕还是故事成片，都能在这里完成。</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {USE_CASES.map(uc => (
        <a href={`/use-cases/${uc.slug}`} class="card group flex flex-col gap-4">
          <span class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <Icon path={uc.icon} size={24} />
          </span>
          <div>
            <h3 class="font-semibold text-ink group-hover:text-brand-700">{uc.title}</h3>
            <p class="mt-1 text-sm text-ink-soft">{uc.tagline}</p>
          </div>
          <span class="mt-auto text-sm font-medium text-brand-600">了解 →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 产品流程 -->
  <section class="border-y border-black/5 bg-brand-50/40">
    <div class="container-page py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">产品流程</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">从 idea 到 assets，只需四步</h2>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {PROCESS_STEPS.map((step, i) => (
          <li class="relative rounded-2xl bg-white p-6 shadow-sm">
            <span class="text-sm font-bold text-brand-500">0{i + 1}</span>
            <h3 class="mt-2 font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-ink-soft">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 核心能力 -->
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">核心能力</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">不止是生成，更是可工程化的生产线</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {CAPABILITIES.map(cap => (
        <div class="card flex gap-4">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <Icon path={cap.icon} size={22} />
          </span>
          <div>
            <h3 class="font-semibold text-ink">{cap.title}</h3>
            <p class="mt-1.5 text-sm leading-6 text-ink-soft">{cap.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 信任模块 -->
  <section class="border-y border-black/5 bg-brand-50/40">
    <div class="container-page py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">为什么信任我们</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">可商用、可追溯、可依赖</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {TRUST_ITEMS.map(t => (
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-ink">{t.title}</h3>
            <p class="mt-2 text-sm leading-6 text-ink-soft">{t.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 定价预览 -->
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">定价</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">从免费开始，按需成长</h2>
      <p class="mt-4 text-lg text-ink-soft">统一积分体系，没有隐藏费用。</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {previewPlans.map(plan => (
        <div class:list={['card flex flex-col', plan.highlighted && 'ring-2 ring-brand-500']}>
          <h3 class="font-semibold text-ink">{plan.name}</h3>
          <div class="mt-3 flex items-baseline gap-1">
            {plan.price === null
              ? <span class="text-2xl font-bold text-ink">定制</span>
              : <><span class="text-3xl font-bold text-ink">¥{plan.price}</span><span class="text-sm text-ink-soft">{plan.period}</span></>}
          </div>
          <p class="mt-2 text-sm text-ink-soft">{plan.description}</p>
          <a href={plan.price === null ? '/contact' : APP_URL} class:list={['mt-5', plan.highlighted ? 'btn-primary' : 'btn-secondary']}>{plan.cta}</a>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/pricing" class="font-medium text-brand-700 hover:text-brand-800">查看完整定价与功能对比 →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-black/5 bg-brand-50/40">
    <div class="container-page py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">常见问题</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">你可能想问的</h2>
      </div>
      <div class="mx-auto mt-10 max-w-3xl divide-y divide-black/5 overflow-hidden rounded-2xl bg-white shadow-sm">
        {FAQ_ITEMS.map(item => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="text-brand-500 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-7 text-ink-soft">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20">
    <div class="overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-8 py-14 text-center text-white sm:px-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">现在就开始，把想法变成作品</h2>
      <p class="mx-auto mt-4 max-w-xl text-brand-100">注册即获免费额度，几分钟完成第一次生成。</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={APP_URL} class="btn bg-white text-brand-700 hover:bg-brand-50">免费开始</a>
        <a href="/contact" class="btn border border-white/30 text-white hover:bg-white/10">联系销售</a>
      </div>
    </div>
  </section>
</BaseLayout>
