---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { SITE } from '../consts'

const updates = (await getCollection('blog', post => !post.data.draft && post.data.category === 'product-updates')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<BaseLayout title={`更新日志 — ${SITE.name}`} description={`${SITE.name} 产品更新日志：新功能、改进与修复。`}>
  <section class="bg-aurora">
    <div class="container-page py-16 text-center">
      <p class="eyebrow">更新日志</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">持续迭代，越来越好用</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-soft">记录每一次功能更新与重要改进。</p>
    </div>
  </section>

  <section class="container-page py-14">
    <ol class="relative mx-auto max-w-3xl border-l border-brand-200 pl-8">
      {updates.map(item => (
        <li class="mb-10">
          <span class="absolute -left-[7px] mt-2 size-3.5 rounded-full border-2 border-white bg-brand-500" />
          <span class="text-sm text-ink-soft"><FormattedDate date={item.data.pubDate} /></span>
          <h2 class="mt-1 text-xl font-bold text-ink">
            <a href={`/blog/${item.id}`} class="hover:text-brand-700">{item.data.title}</a>
          </h2>
          <p class="mt-2 leading-7 text-ink-soft">{item.data.description}</p>
          <a href={`/blog/${item.id}`} class="mt-2 inline-block text-sm font-medium text-brand-600">查看详情 →</a>
        </li>
      ))}
      {updates.length === 0 && (
        <li class="text-ink-soft">暂无更新。</li>
      )}
    </ol>
  </section>
</BaseLayout>
