# 依赖（bun install）
node_modules

# 仅保留根 bun.lock，子包 lockfile 由 workspace 管理
apps/*/bun.lock
packages/*/bun.lock

# 输出目录
out
dist
*.tgz

# 代码覆盖率
coverage
*.lcov
.codegraph

# 日志
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# 环境变量文件
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# 缓存
.eslintcache
.cache
*.tsbuildinfo

# IDE
.idea

# Claude Code 机器本地配置（约定不入库）。
# 只忽略 settings.local.json；团队共享的 settings.json / hooks / skills 仍入库。
.claude/settings.local.json

# 上传目录
uploads

# 误以 apps/server/src 为工作目录运行时遗留的本地产物
# （相对化的 $TMPDIR 骨架 / 上传骨架）。正常上传目录在 apps/server/uploads。
apps/server/src/var/
apps/server/src/uploads/

# 系统文件
.DS_Store
.git-commit-msg
